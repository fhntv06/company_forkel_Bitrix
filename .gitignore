# ==========================================
# 1C-Bitrix generated files and core
# ==========================================

# Bitrix core (включает bitrix/php_interface, bitrix/templates, bitrix/cache и т. д.)
# Собственный код хранится только в /backend/www/local/ (DEC-DEV-10)
/backend/www/bitrix/

# Uploaded files and generated content
/backend/www/upload/

# Файлы с доступами к БД (внутри /bitrix/ уже игнорируются, пути указаны явно как страховка)
/backend/www/bitrix/php_interface/dbconn.php
/backend/www/bitrix/.settings.php
/backend/www/bitrix/.settings_extra.php

# Установщик и восстановление
/backend/www/bitrixsetup.php
/backend/www/restore.php
/backend/www/backup/
/backend/www/restore/

# Кеш собственного кода в local/
/backend/www/local/cache/
/backend/www/local/managed_cache/