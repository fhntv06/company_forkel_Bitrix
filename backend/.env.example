
# FORKEL — локальное окружение Docker
# Скопируйте в .env и задайте собственные пароли.
# Не используйте эти значения в production.

# MySQL
MYSQL_DATABASE=forkel
MYSQL_USER=forkel_user
MYSQL_PASSWORD=change_me_local_password
MYSQL_ROOT_PASSWORD=change_me_local_root_password

# PHP / приложение
APP_ENV=local
APP_DEBUG=1
