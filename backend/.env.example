# FORKEL — окружение Docker и настройки интеграций (Beta / Production)
# Скопируйте в .env и задайте собственные пароли и ключи.
# Не коммитьте .env с реальными секретами.

# MySQL
MYSQL_DATABASE=forkel
MYSQL_USER=forkel_user
MYSQL_PASSWORD=change_me_local_password
MYSQL_ROOT_PASSWORD=change_me_local_root_password

# PHP / приложение
# APP_ENV: local | stage | production. Тестовые миграции (config «testdata») видны ТОЛЬКО при APP_ENV=local.
APP_ENV=local
APP_DEBUG=1
SITE_EMAIL=forkel.ru@mail.ru

# Почта (SMTP — для локального тестирования можно подключить Mailpit)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=forkel.ru@mail.ru

# Уведомления менеджерам в MAX (INT-008; если пусто — Beta-лог в local/logs/max_notifications.log)
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_API_URL=https://botapi.max.ru

# Онлайн-оплата: ЮKassa / Альфа-Банк + СБП + 54-ФЗ (INT-006; если пусто — Sandbox-режим)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
ALFABANK_USER=
ALFABANK_PASSWORD=
PAYMENT_SANDBOX=1

# Доставка СДЭК (INT-007; если пусто — фиксированный Beta-тариф 450 ₽)
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_SANDBOX=1

# Яндекс.Карты (INT-002; если пусто — отображается SVG-заглушка V4 с 4 точками)
YANDEX_MAPS_API_KEY=

# Обмен с 1С: пароль технического пользователя 1c_exchange (используется миграцией при его создании;
# если пусто — создаётся случайный пароль, его нужно задать в админке перед настройкой обмена)
ONEC_EXCHANGE_PASSWORD=
