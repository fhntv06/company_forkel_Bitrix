# FORKEL — окружение Docker и настройки интеграций (Beta / Production)
# Скопируйте в .env и задайте собственные пароли и ключи.
# Не коммитьте .env с реальными секретами.
# После изменения .env пересоздайте контейнер PHP: docker compose up -d php

# MySQL
MYSQL_DATABASE=forkel
MYSQL_USER=forkel_user
MYSQL_PASSWORD=change_me_local_password
MYSQL_ROOT_PASSWORD=change_me_local_root_password

# PHP / приложение
# APP_ENV: local | stage | production. Тестовые миграции (config «testdata») видны ТОЛЬКО при APP_ENV=local.
APP_ENV=local
APP_DEBUG=1
SITE_EMAIL=forkel.ru@mail.ru
# Публичный адрес сайта без «/» в конце (на боевом — https://...). Нужен для адресов возврата и callback банка.
# Если пусто — берётся адрес текущего запроса (локально http://localhost:9090).
SITE_URL=

# Почта (SMTP — для локального тестирования можно подключить Mailpit)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=forkel.ru@mail.ru

# Уведомления менеджерам в MAX (INT-008; если пусто — Beta-лог в local/logs/max_notifications.log)
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_API_URL=https://botapi.max.ru

# Онлайн-оплата: интернет-эквайринг Альфа-Банка, карты + СБП (INT-006, DEC-013)
# Доступ к API: либо логин/пароль API-пользователя магазина (обычно вида xxx-api), либо токен.
# Пока доступы пустые и PAYMENT_SANDBOX=1 — песочница сайта (оплата подтверждается кнопкой, без банка).
# На боевом сайте поставьте PAYMENT_SANDBOX=0: без доступов онлайн-оплата будет недоступна, а не тестовой.
ALFABANK_USER=
ALFABANK_PASSWORD=
ALFABANK_TOKEN=
# 1 — тестовый контур банка (https://alfa.rbsuat.com), 0 — боевой (https://payment.alfabank.ru)
ALFABANK_TEST_MODE=1
# Ключ для проверки checksum callback-уведомлений (выдаёт банк). На боевом обязателен.
ALFABANK_CALLBACK_SECRET=
# Необязательно: другие адреса API, если банк выдал их (по умолчанию — адреса выше + /payment/rest/)
ALFABANK_API_URL=
ALFABANK_TEST_API_URL=
# Зарезервировано: передача чека 54-ФЗ через банк (orderBundle) пока НЕ реализована
ALFABANK_FFD_ENABLED=0
PAYMENT_SANDBOX=1

# Доставка СДЭК (INT-007; если пусто — фиксированный Beta-тариф 450 ₽)
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_SANDBOX=1

# Яндекс.Карты (INT-002; если пусто — отображается SVG-заглушка V4 с 4 точками)
YANDEX_MAPS_API_KEY=

# Обмен с 1С: пароль технического пользователя 1c_exchange (используется миграцией при его создании;
# если пусто — создаётся случайный пароль, его нужно задать в админке перед настройкой обмена)
ONEC_EXCHANGE_PASSWORD=
